      "parameters": {
        "jsCode": "const transcript = String($json.text ?? $json.transcript ?? '').trim();\nif (!transcript) throw new Error('Speech-to-text returned no transcript');\nlet sessionId = 'local-audio-session';\ntry { const w = $('Local Audio Upload (Legacy)').first().json; sessionId = String(w?.body?.sessionId ?? w?.query?.sessionId ?? sessionId); } catch (_) {}\nreturn [{ json: { sessionId, level: 'B1', topic: 'Free conversation', correctionMode: 'coach', chatInput: `[Learner level: B1; Topic: Free conversation; Correction mode: coach]\\n${transcript}` } }];"
