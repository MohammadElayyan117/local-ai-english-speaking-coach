      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst message = String(body.message ?? body.chatInput ?? '').trim();\nif (!message) throw new Error('No message received');\nconst sessionId = String(body.sessionId ?? 'english-coach-default');\nconst level = String(body.level ?? 'B1');\nconst topic = String(body.topic ?? 'Free conversation');\nconst correctionMode = String(body.correctionMode ?? 'coach');\nreturn [{ json: { sessionId, level, topic, correctionMode, chatInput: `[Learner level: ${level}; Topic: ${topic}; Correction mode: ${correctionMode}]\\n${message}` } }];"
